# Copie este archivo como .env si quiere cambiar los valores por defecto.
# El archivo .env NO se sube al repositorio (está en .gitignore).
PORT=3000
DB_PATH=./data/inventario.db

# Contraseña común para los usuarios de ejemplo de "npm run seed".
# Si la deja vacía, el seed genera una contraseña aleatoria por usuario
# y la muestra en la consola.
DEMO_PASSWORD=
