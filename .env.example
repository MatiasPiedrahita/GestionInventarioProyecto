# Copie este archivo como .env si quiere cambiar los valores por defecto.
# El archivo .env NO se sube al repositorio (está en .gitignore).
PORT=3000
DB_PATH=./data/inventario.db

# Contraseña común para los usuarios de ejemplo de "npm run seed".
# Si la deja vacía, el seed genera una contraseña aleatoria por usuario
# y la muestra en la consola.
DEMO_PASSWORD=

# --- Avisos por correo (HU-08) -------------------------------------------
# Sin SMTP_HOST los correos NO se envían: quedan en la bandeja de salida,
# que se puede leer en Administración > Sistema (modo simulado).
# Para enviarlos de verdad, complete estos datos con los de su proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Taller <avisos@taller.local>

# Dirección pública de la aplicación, para el enlace que va en los correos.
APP_URL=http://localhost:3000

# Cada cuántos minutos la tarea programada revisa todo el inventario.
ALERTAS_INTERVALO_MIN=15
